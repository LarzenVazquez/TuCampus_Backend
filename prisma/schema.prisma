generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "business"]
}

// --- ESQUEMA AUTH (Usuarios, Seguridad y Sesiones) ---

model User {
  @@schema("auth")
  id                  String   @id @default(uuid())
  nombre              String
  email               String   @unique
  password            String
  matricula           String?
  rol                 String   @default("Al")
  vendedor_verificado Boolean  @default(false)
  email_verificado    Boolean  @default(false)
  es_becado           Boolean  @default(false)
  created_at          DateTime @default(now())

  // --- CAMPOS DE DOBLE FACTOR DE AUTENTICACIÓN (2FA) ---
  two_factor_enabled  Boolean  @default(false)
  two_factor_secret   String?  // Almacena el secreto Base32 del protocolo TOTP

  // Relaciones
  productos      Product[]      @relation("VendedorRelation")
  archivos       File[]
  notificaciones Notificacion[]
  sesiones       Session[]
  actividades    ActivityLog[]
  ventas         Market[]       @relation("Vendedor")
  compras        Order[]
  chatsComprador Chat[]         @relation("Comprador")
  chatsVendedor  Chat[]         @relation("Vendedor")
  userFiles      UserFile[]
}

model UserFile {
  @@schema("auth")
  id             Int      @id @default(autoincrement())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  nombre_archivo String
  url_archivo    String
  file_hash      String
  tipo_archivo   String
  createdAt      DateTime @default(now())
}

model Session {
  @@schema("auth")
  id         String   @id @default(uuid())
  token      String   @unique
  expira_en  DateTime
  userId     String
  user       User     @relation(fields: [userId], references: [id])
}
// --- ESQUEMA BUSINESS (Market, Productos, Pedidos y Logs) ---

model Product {
  @@schema("business")
  id              String           @id @default(uuid())
  nombre          String
  descripcion     String?
  precio          Decimal
  calorias        Int              @default(0)
  categoria       String
  stock           Int              @default(0)
  reservado       Int              @default(0)
  estado          String           @default("DISPONIBLE")
  tipo            String           @default("Cafeteria")
  imagenUrl       String
  tiempoPrepMin   Int              @default(8)
  esMenuBeca      Boolean          @default(false)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  vendedorId      String
  vendedor        User             @relation("VendedorRelation", fields: [vendedorId], references: [id])
  itemsOrder      OrderItem[]
  recomendaciones Recommendation[]
}

model Market {
  @@schema("business")
  id               String   @id @default(uuid())
  vendedorId       String
  vendedor         User     @relation("Vendedor", fields: [vendedorId], references: [id])
  titulo           String
  descripcion      String
  precio           Decimal
  categoria        String   @default("Otros")
  imagenes         String[]
  estatus          String   @default("pendiente") // pendiente, activo, vendido, rechazado, bando
  motivoRechazo    String?
  fechaPublicacion DateTime @default(now())
  chats            Chat[]
}

model Order {
  @@schema("business")
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  total      Decimal
  metodoPago String      @default("Mercado Pago")
  status     String      @default("CARRITO")
  tipo       String      @default("Normal") // "Normal" | "Beca"
  qrCodeData String?     @unique
  fecha      DateTime    @default(now())
  tiempoEstimadoMin Int?
  fechaListo        DateTime?
  fechaEntregado    DateTime?
  items      OrderItem[]
}

model OrderItem {
  @@schema("business")
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  nombre    String
  cantidad  Int
  precio    Decimal
}

model Chat {
  @@schema("business")
  id          String    @id @default(uuid())
  compradorId String
  comprador   User      @relation("Comprador", fields: [compradorId], references: [id])
  vendedorId  String
  vendedor    User      @relation("Vendedor", fields: [vendedorId], references: [id])
  productoId  String
  producto    Market    @relation(fields: [productoId], references: [id])
  mensajes    Message[]
  last_update DateTime  @default(now())
}

model Message {
  @@schema("business")
  id         String   @id @default(uuid())
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id])
  sender_id  String
  text       String
  read       Boolean  @default(false)
  created_at DateTime @default(now())
}

model ActivityLog {
  @@schema("business")
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  accion      String
  descripcion String
  ip_address  String?
  fecha       DateTime @default(now())
}

model File {
  @@schema("business")
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  nombre_archivo String
  url_archivo    String
  file_hash      String
  tipo_archivo   String
  fecha_subida   DateTime @default(now())
}

model Notificacion {
  @@schema("business")
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  mensaje String
  leida   Boolean  @default(false)
  fecha   DateTime @default(now())
}

model Recommendation {
  @@schema("business")
  id                     String   @id @default(uuid())
  producto_base_id       String
  producto               Product  @relation(fields: [producto_base_id], references: [id])
  nombre_producto        String
  precio                 Decimal
  categoria              String
  imagenUrl              String
  tipo                   String   @default("Cafeteria")
  calorias               Int      @default(0)
  score_relevancia       Float
  hora_prediccion        Int
  ultima_actualizacion   DateTime @default(now())

  @@unique([producto_base_id, hora_prediccion])
}
